# Wisphub API credentials — get token from: Staff Management > Personnel List > "Generate My APIKey"
WISPHUB_TOKEN=your_api_key_here
# Base URL — verify against your Wisphub API docs (typically https://api.wisphub.net/api/ or https://api.wisphub.app/api/)
WISPHUB_BASE_URL=https://api.wisphub.net/api/
PORT=3001
