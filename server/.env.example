# Wisphub API credentials — get token from: Staff Management > Personnel List > "Generate My APIKey"
WISPHUB_TOKEN=your_api_key_here
# Base URL — confirmed: https://api.wisphub.io (without trailing /api/)
WISPHUB_BASE_URL=https://api.wisphub.io
PORT=3001

# Google Sheets API — para inversión accionistas
# Crear API Key en: cloud.google.com > APIs & Services > Credentials > Create credentials > API Key
# Restringir la key a "Google Sheets API"
GOOGLE_SHEETS_API_KEY=your_google_api_key_here
# Nombre exacto de la pestaña (tab) en el Google Sheet
GOOGLE_SHEETS_TAB_NAME=Hoja1
